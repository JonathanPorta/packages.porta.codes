#!/bin/bash
# Tracked template for the DEFAULT (Cloudflare-only) domain. For local use:
#   cp .env-sample .env                       # gitignored
#   read -rs BWS_ACCESS_TOKEN && export BWS_ACCESS_TOKEN   # packages.porta.codes-ci token
#   source .env && source scripts/bws/load.sh
#
# scripts/bws/bootstrap.sh auto-fills BWS_PROJECT_ID below from the placeholder.

export APP_NAME='packages.porta.codes'

# Bitwarden Secrets Manager project id — auto-filled by scripts/bws/bootstrap.sh.
export BWS_PROJECT_ID="b8462306-bf7e-4a3f-bbc0-b4d20015a4c7"

# AWS is NEVER loaded from BWS here: CI uses GitHub OIDC roles, and a local
# operator uses their SSO profile (aws sso login --profile portaj).
export AWS_REGION=us-east-1
