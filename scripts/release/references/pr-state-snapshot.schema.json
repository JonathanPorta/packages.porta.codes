{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blessed-cicd/schemas/pr-state-snapshot/v1",
  "title": "blessed/pr-state-snapshot/v1",
  "description": "A closed, MANDATORY description of the receiver's relevant pull-request state at the moment apply runs. It is required even when nothing matches \u2014 an empty result must be stated explicitly, because 'no snapshot supplied' and 'no PR exists' are different facts and treating them alike lets a duplicate promotion open a second PR for the same channel. Adoption is never decided from this document alone: a claimed head SHA is checked against the receiver's local object store and the actual blob bytes at every declared output path, because a branch name and a self-reported digest are both attacker-choosable.",
  "type": "object",
  "required": [
    "schema",
    "repo",
    "query",
    "pull_requests",
    "branches"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "blessed/pr-state-snapshot/v1"
    },
    "repo": {
      "$ref": "#/$defs/repo"
    },
    "query": {
      "description": "What was asked for, so an empty result can be distinguished from a narrow one.",
      "type": "object",
      "required": [
        "head_ref_prefix",
        "states"
      ],
      "additionalProperties": false,
      "properties": {
        "head_ref_prefix": {
          "type": "string",
          "minLength": 1
        },
        "states": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "OPEN",
              "CLOSED",
              "MERGED"
            ]
          }
        }
      }
    },
    "pull_requests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "number",
          "state",
          "head_repo",
          "head_ref",
          "head_sha",
          "base_repo",
          "base_ref",
          "base_sha"
        ],
        "additionalProperties": false,
        "properties": {
          "number": {
            "type": "integer",
            "minimum": 1
          },
          "state": {
            "enum": [
              "OPEN",
              "CLOSED",
              "MERGED"
            ]
          },
          "head_repo": {
            "$ref": "#/$defs/repo"
          },
          "head_ref": {
            "type": "string",
            "minLength": 1
          },
          "head_sha": {
            "$ref": "#/$defs/sha40"
          },
          "base_repo": {
            "$ref": "#/$defs/repo"
          },
          "base_ref": {
            "type": "string",
            "minLength": 1
          },
          "base_sha": {
            "$ref": "#/$defs/sha40"
          },
          "merge_commit_sha": {
            "description": "For a MERGED PR, the immutable merge (or squash) commit on the base branch. A merged record without it cannot be tied to the receiver's own history, so it cannot authorize a replay.",
            "$ref": "#/$defs/sha40"
          }
        }
      }
    },
    "branches": {
      "description": "Remote branches matching the prefix, so a branch that exists without a PR is a visible collision rather than a silent overwrite.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "sha"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "sha": {
            "$ref": "#/$defs/sha40"
          }
        }
      }
    }
  },
  "$defs": {
    "repo": {
      "type": "string",
      "pattern": "^(?=[^/]{1,39}/)[A-Za-z0-9](-?[A-Za-z0-9])*/(?!\\.\\.?$)[A-Za-z0-9._-]{1,100}$"
    },
    "sha40": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    }
  }
}
