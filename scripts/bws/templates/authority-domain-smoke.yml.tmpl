# GENERATED by `authority-domains.sh install-smoke-workflow` from blessed.yml.
# Do not hand-edit; re-render after changing the domain. Non-mutating proof that the
# @@ENV@@ authority domain works end to end: the real GitHub Environment, its scoped
# BWS_ACCESS_TOKEN, the machine-account grant, the secret, and the keypair must all
# agree — signing a challenge that verifies against the COMMITTED public trust store.
# Correlated by run-name so the rotation tool can identify the EXACT dispatched run.
#
# SECURITY: workflow_dispatch inputs are CALLER-CONTROLLED. They enter ONLY as
# job-level env and are VALIDATED by a secret-free FIRST step that runs before
# checkout and before the signing key is loaded. No `${{ inputs.* }}` ever appears
# inside a `run:` block (that expands into the script text = injection). The signing
# step reads the already-validated value from $NEW_KEY_ID.
name: 🔏 Authority domain smoke (@@ENV@@)
run-name: authority-smoke:${{ inputs.rotation_id }}:${{ inputs.new_key_id }}

on:
  workflow_dispatch:
    inputs:
      rotation_id:
        description: 'Opaque rotation id (correlation)'
        required: true
      new_key_id:
        description: 'Expected active key_id'
        required: true

permissions:
  contents: read

jobs:
  sign-verify:
    if: github.ref == 'refs/heads/@@BRANCH@@'
    runs-on: ubuntu-latest
    environment: @@ENV@@
    # Caller-controlled dispatch inputs enter ONLY as env — they are NEVER
    # interpolated into a run: script (that expansion is a script-injection sink).
    env:
      ROTATION_ID: ${{ inputs.rotation_id }}
      NEW_KEY_ID: ${{ inputs.new_key_id }}
    steps:
      - name: 🧪 Validate dispatch inputs (secret-free — runs BEFORE checkout/load-secrets)
        # First line of defense. If either input fails its grammar, the job stops
        # here — before the repo is checked out and long before the signing key is
        # loaded. Values are read from env (safe), not interpolated into this script.
        run: |
          set -euo pipefail
          if [[ "$ROTATION_ID" == *..* ]]; then echo "::error::rotation_id contains '..'"; exit 1; fi
          if [[ "$NEW_KEY_ID" == *..* ]]; then echo "::error::new_key_id contains '..'"; exit 1; fi
          if [[ ! "$ROTATION_ID" =~ ^rotation-[0-9A-Za-z._-]{1,80}$ ]]; then echo "::error::rotation_id fails grammar"; exit 1; fi
          if [[ ! "$NEW_KEY_ID" =~ ^[a-z0-9][a-z0-9._-]{0,63}$ ]]; then echo "::error::new_key_id fails grammar"; exit 1; fi
          echo "dispatch inputs validated (rotation_id + new_key_id)"
      - uses: actions/checkout@34e114876b0b11c390a56381ad16ebd13914f8d5  # v4
      - uses: ./.github/actions/install-yq
      - name: 🔒 Verify signing category integrity (BEFORE touching the key)
        # Verifier ships inside the bws category, so this works on a tarball-only
        # consumer that never installs the source-tree scripts/manifest.sh.
        run: scripts/bws/verify-category-manifest.sh scripts/signing
      - name: 🔐 Load ONLY the release signing key (@@ENV@@ authority)
        uses: ./.github/actions/load-secrets
        with:
          access_token: ${{ secrets.BWS_ACCESS_TOKEN }}
          profile: @@PROFILE@@
      - name: 🔏 Sign + verify a challenge (no release mutation)
        run: |
          set -euo pipefail
          KID="$NEW_KEY_ID"
          printf 'authority-domain-smoke %s %s' "$KID" "$GITHUB_SHA" >challenge.txt
          scripts/signing/sign.sh --profile ed25519-detached-v1 --input challenge.txt \
            --private-key-env @@SECRET@@ --output challenge.sig
          scripts/signing/verify.sh --profile ed25519-detached-v1 --input challenge.txt \
            --signature challenge.sig --trust-store release-trusted-keys.json --key-id "$KID"
          echo "PASS: @@ENV@@ authority signed a challenge verified by the committed $KID public key"
