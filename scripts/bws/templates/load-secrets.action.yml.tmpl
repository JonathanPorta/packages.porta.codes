#>>> TEMPLATE-ONLY HEADER — everything above the marker is stripped at render time.
#
# CANONICAL load-secrets composite action: the SINGLE source of the loader's
# shape. Rendered by scripts/bws/bootstrap.sh (emit_load_secrets_action_yml), and
# with the canonical default key set into
# templates/.github/actions/load-secrets/action.yml.
#
# It lives HERE, inside the vendored bws category, so a consumer that vendored
# scripts/bws/ without the surrounding blessed-cicd layout still renders the
# right thing. bootstrap.sh previously carried a duplicate heredoc emitter whose
# template lookup pointed at a directory that does not exist, so the fallback
# always won — and it silently kept shipping a floating `uses:` ref long after
# the canonical template was fixed. One source, or the regression returns.
#
# The secret-lines placeholder below is replaced with one `<uuid> > <NAME>` line
# per active key. tests/test-bws-loader-golden.sh proves the rendered result
# matches the canonical template exactly.
#<<< END TEMPLATE-ONLY HEADER
name: 'Load Secrets'
description: 'Load secrets from Bitwarden Secrets Manager into job env.'

# Reference template — the canonical 5-key static-site portfolio set.
# `scripts/bws/bootstrap.sh --scaffold` generates this file from the active KEYS
# array at runtime (so .bws-secrets-list overrides are honored). SLACK_WEBHOOK_URL
# is NOT a default — Slack flows through github-slack-router, not per-repo webhooks.
# A repo that opts back into a per-repo webhook adds SLACK_WEBHOOK_URL to its
# .bws-secrets-list (which adds the matching line here on scaffold).
#
# CLOUDFLARE_ACCOUNT_ID and BETTERUPTIME_API_TOKEN carry the canonical
# _shared-ci UUIDs (the SAME in every repo) — they live in the shared project,
# so bootstrap skips them. The other lines are per-project placeholders that
# bootstrap fills on first run. See docs/shared-secrets.md.

inputs:
  access_token:
    description: 'BWSM machine-account access token (set via secrets.BWS_ACCESS_TOKEN).'
    required: true

runs:
  using: 'composite'
  steps:
    - name: '🔐 Load Secrets from Bitwarden'
      shell: bash
      env:
        # The native binary reads INPUT_* from the environment (Actions
        # convention) and does its own masking + GITHUB_ENV export, so the
        # caller contract is identical to the old `uses:` form.
        INPUT_ACCESS_TOKEN: ${{ inputs.access_token }}
        INPUT_SECRETS: |
__BWS_SECRET_LINES__
      # This deliberately does NOT `uses: bitwarden/sm-action@<sha>`.
      #
      # That action's index.js is a ~6KB downloader: it fetches a release asset,
      # chmod 0755's it, and execSync's it with no digest check and no signature.
      # A commit pin therefore pins the DOWNLOADER while the executed bytes stay
      # unpinned and mutable — release assets can be replaced under the same tag.
      # It also honours SM_ACTION_VERSION from the environment (an earlier step
      # could redirect the download) and silently falls back to `cargo build`.
      #
      # scripts/bws/sm-action-run.sh fetches the same binary and verifies it
      # against the committed digests in scripts/bws/sm-action.pins before
      # executing anything. Fail-closed; no source-build fallback.
      run: bash "$GITHUB_WORKSPACE/scripts/bws/sm-action-run.sh"
