# The DEFAULT authority domain of packages.porta.codes: Cloudflare ONLY.
#
# BWS project packages.porta.codes, machine account packages.porta.codes-ci
# (read-only on packages.porta.codes and _shared-ci), repository-level
# BWS_ACCESS_TOKEN. Loaded with `profile: default` by .github/actions/load-secrets,
# for Terraform (terraform-plan.yml, terraform-apply.yml) and `make verify-edge`.
#
# NO AWS KEY, EVER (blessed-cicd #9): every AWS call runs as a GitHub OIDC role
# session. Never add an AWS access key here.
# No Better Uptime token: monitoring is off (providers.tf).
#
# Format: KEY[?] [shared] [type:VALUE]   (scripts/bws/README.md)

CLOUDFLARE_ACCOUNT_ID    shared  type:cloudflare_account_id
CLOUDFLARE_API_TOKEN             type:cloudflare_api_token
